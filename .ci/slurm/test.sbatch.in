#!/usr/bin/env bash
#SBATCH --job-name=libddla-gpu-tests
#SBATCH --partition=@TEST_PARTITION@
#SBATCH --qos=@TEST_QOS@
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=8
#SBATCH --gpus-per-node=8
#SBATCH --time=@TEST_TIME@
#SBATCH --dependency=afterok:@BUILD_JOB@
#SBATCH --output=@RESULTS@/test-slurm-%j.log
#SBATCH --export=NIL

set -euo pipefail
export HOME=@HOME@
export USER=${SLURM_JOB_USER:?}
export LOGNAME=$USER
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export OMP_NUM_THREADS=1
source @MAPPING_ROOT@/${SLURM_JOB_PARTITION}.bash
source @CONTROL@/modules.sh
CI_SYSTEM_MPIRUN=$(command -v mpirun)
export CI_SYSTEM_MPIRUN
export CI_CONTAINER_IMAGE=@CONTAINER_IMAGE@
export CI_MPI_ROOT=@MPI_ROOT@
container=(apptainer exec --nv --containall --cleanenv --bind /opt:/opt:ro --bind /usr:/usr:ro --bind /lib:/lib:ro --bind /lib64:/lib64:ro --bind @MPI_ROOT@:@MPI_ROOT@:ro --bind @SOURCE@:@SOURCE@:ro --bind @BUILD@:@BUILD@ --bind @RESULTS@:@RESULTS@ --bind @CONTROL@:@CONTROL@:ro --bind @MAPPING_ROOT@:@MAPPING_ROOT@:ro --env "PATH=$PATH" --env "LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}" --env "CI_SYSTEM_MPIRUN=$CI_SYSTEM_MPIRUN" --env "MAP_OPT=$MAP_OPT" --env "SLURM_EXPORT_ENV=$SLURM_EXPORT_ENV" --env "OMPI_MCA_plm_slurm_args=$OMPI_MCA_plm_slurm_args" --env "PRTE_MCA_plm_slurm_args=$PRTE_MCA_plm_slurm_args" "$CI_CONTAINER_IMAGE")
export MAP_OPT
export SLURM_EXPORT_ENV=ALL
export OMPI_MCA_plm_slurm_args=--external-launcher
export PRTE_MCA_plm_slurm_args=--external-launcher
if [[ @DISABLE_NCCL_IB@ == true ]]; then
    export NCCL_IB_DISABLE=1
else
    unset NCCL_IB_DISABLE
fi
module -t list 2>&1 | tee @RESULTS@/modules-test.txt
"${container[@]}" bash -lc 'command -v ctest mpirun nvidia-smi' | tee @RESULTS@/tools-test.txt
"${container[@]}" nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv,noheader \
    | tee @RESULTS@/gpus.txt
nvidia-smi dmon -s pucvmte -o T > @RESULTS@/dmon-${SLURM_JOB_ID}.log &

set +e
"${container[@]}" ctest --test-dir @BUILD@ -L "gpu|cpu" -j1 --output-on-failure \
    --output-junit @RESULTS@/ctest.xml 2>&1 | tee @RESULTS@/ctest.log
ctest_rc=${PIPESTATUS[0]}
set -e
python3 @CONTROL@/report.py \
    --manifest @RESULTS@/manifest.json \
    --junit @RESULTS@/ctest.xml \
    --results @RESULTS@ \
    --job-id "$SLURM_JOB_ID"
exit "$ctest_rc"
